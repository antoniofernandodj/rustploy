<!--
  Botão de aba genérico. "Ligado" (`tab_on`) quando o valor atual da aba
  ({current}, passado pelo chamador — ex.: "{docker_tab}") é igual ao `target`
  desta aba; caso contrário neutro (`tab`). `equals` é interpolado, então
  compara os dois valores dinâmicos.
-->
<component>
  <props>
    <prop name="label" />
    <prop name="current" />
    <prop name="target" />
    <prop name="action" />
  </props>
  <resources>
    <style>
    .tab_on {
      color: var(--blue);
      padding: 9 16;
      border-radius: 5
    }
    </style>
  </resources>

  <template if="{current}" equals="{target}">
    <button
      class="tab_on"
      on_click="{action}"
      text="{label}"
    />
  </template> <template else>
    <button
      class="tab"
      on_click="{action}"
      text="{label}"
    />
  </template>
</component>
