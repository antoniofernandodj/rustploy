<!--
  Item de navegação da sidebar: ícone (sempre visível) + rótulo (some abaixo de
  900px de largura — ver @media abaixo, espelhando o breakpoint em que a
  sidebar encolhe no shell.gv). Fica "ligado" (pílula azul) quando a view
  atual ({view}) casa com `target` — via `one_of` (glacier-ui 0.57.8), não
  `equals`: `target` pode ser mais de uma view separada por espaço (ex.:
  "projects project_services service"), pra um item continuar aceso nas
  sub-telas dele. Um `target` de uma view só (a maioria) funciona igual —
  `one_of` com uma lista de um token só é uma comparação de igualdade.
  Antes da 0.57.8 isso não dava pra fazer sem inventar gramática de
  expressão: o item "Projects" apagava assim que você entrava num projeto.

  Era um botão-texto puro (Button, com o rótulo em `text`), mas até a 0.57.5
  do glacier-ui o widget de botão não suportava filhos — não dava pra por
  ícone+texto lado a lado dentro dele. Tinha virado uma linha (row) com
  on_press, o mesmo mecanismo de clique dos handles de resize/drag do
  titlebar (qualquer nó com on_press/cursor vira um mouse_area) — hack
  removido na 0.57.6 (`<Button>` com filhos: um filho vira o conteúdo direto,
  mais de um vira um Row implícito respeitando spacing/align-y do próprio
  nó — exatamente o caso de ícone+rótulo aqui). Em janelas estreitas, o
  rótulo ("Deploy Engine", "Projects (2)") não cabia na sidebar encolhida e,
  sem espaço para quebrar (ou sendo uma palavra só), estourava e quebrava o
  layout — abaixo do breakpoint, só o ícone fica visível.

  `tooltip="{label}"` (glacier-ui 0.37.5) mostra o rótulo completo ao pairar o
  mouse — essencial no modo colapsado (ícone sozinho, sem texto nenhum), e sem
  custo no modo largo (o rótulo já está visível do lado, o balão é redundante
  mas inofensivo). O wrap acontece depois do mouse_area em widget.rs, então o
  hover funciona na linha inteira, não só no ícone.
-->
<component>
    <!-- `view` NÃO entra aqui: ela vem do contexto global (é a view atual do
      app), não de quem instancia o item. Declarar só o que é prop é o que
      mantém a leitura do contexto funcionando. -->
  <props>
    <prop name="label" />
    <prop name="icon" />
    <prop name="target" />
    <prop name="action" />
  </props>
  <resources>
    <style>
    .nav_row_on  { width: fill; padding: 11 14; spacing: 10; align-y: center; color: var(--blue); cursor: pointer; }
    .nav_row_off { width: fill; padding: 11 14; spacing: 10; align-y: center; color: var(--surface); cursor: pointer; }
    .nav_icon_on   { size: 14; color: var(--text); }
    .nav_icon_off  { size: 14; color: var(--faint); }
    .nav_label_on  { color: var(--text); }
    .nav_label_off { color: var(--muted); }

    @media (max-width: 900) {
      /* O GSS não suporta seletor agrupado por vírgula (".a, .b { }") — cada
         classe precisa da sua própria declaração, dentro E fora de @media (um
         ".a, .b {}" vira uma ÚNICA chave literal errada no dicionário de regras,
         nunca casando com nenhuma classe real; ver diagnóstico que achou isso). */
      .nav_row_on  { padding: 11 0; spacing: 0; }
      .nav_row_off { padding: 11 0; spacing: 0; }
      .nav_label_on  { hidden: true; }
      .nav_label_off { hidden: true; }
      /* Com o rótulo escondido, o ícone é o único filho da linha — centraliza-se
         preenchendo a largura e usando text-align (não dá pra centralizar ao
         longo do eixo principal de uma row só com align-y/align-x). */
      .nav_icon_on  { width: fill; text-align: center; }
      .nav_icon_off { width: fill; text-align: center; }
    }
    </style>
  </resources>

  <button class="nav_row_on" if="{view}" one_of="{target}" on_click="{action}" tooltip="{label}">
    <text class="nav_icon_on">{icon}</text>
    <text class="nav_label_on">{label}</text>
  </button>
  <button class="nav_row_off" else on_click="{action}" tooltip="{label}">
    <text class="nav_icon_off">{icon}</text>
    <text class="nav_label_off">{label}</text>
  </button>
</component>
