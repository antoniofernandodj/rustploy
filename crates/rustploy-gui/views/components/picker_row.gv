<!--
  Linha de escolha do wizard "Novo serviço": título + subtítulo à esquerda e um
  botão de ação à direita. Usada nos passos de escolha de tipo, de banco e de
  template.
-->
<component>
    <props>
        <prop name="title" />
        <prop name="subtitle" />
        <prop name="button_label" />
        <prop name="action" />
    </props>
  <row class="kv_row">
    <column class="header_titles">
      <text class="env_key">{title}</text>
      <text class="muted">{subtitle}</text>
    </column>
    <button
      class="btn_primary"
      on_click="{action}"
      text="{button_label}"
    />
  </row>
</component>
