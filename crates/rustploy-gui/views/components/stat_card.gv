<!--
  Tile de KPI do cabeçalho (STATUS/UPTIME/SERVICES/CPU/…). Com accent="1" o
  número usa o realce verde (`stat_num_g`); sem accent, o neutro (`stat_num`).
  Prop ausente vira string vazia (process_template), então != "1" → neutro.
-->
<component>
    <!-- `accent` é opcional e o default é a string vazia — que é o que a prop
      ausente já valia. O template compara com "1", então vazio → neutro. -->
    <props>
        <prop name="label" />
        <prop name="value" />
        <prop name="accent" default="" />
    </props>
  <resources>
    <style>
    .stat_card  {
      background: var(--surface);
      border-radius: 6;
      border-width: 1;
      border-color: var(--border);
      padding: 16 22;
      spacing: 6;
    }

    .stat_num   {
      size: 26;
      bold: true;
      color: var(--accent);
    }

    .stat_num_g {
      size: 26;
      bold: true;
      color: var(--ok);
    }
    </style>
  </resources>

  <column class="stat_card">
    <text class="label_cap">{label}</text>
    <text class="stat_num_g" if="{accent}" equals="1">
      {value}
    </text>
    <text class="stat_num" else>{value}</text>
  </column>
</component>
