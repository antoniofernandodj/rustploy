<!--
  Linha "Carregando dados…" com spinner. A CONDIÇÃO de exibição fica no
  chamador (`if cond="{flag}" equals="true" { LoadingRow }`), não aqui dentro:
  um componente instanciado direto (fora de `for-each`) tem a prop resolvida
  uma vez e não re-avalia quando o flag muda — então um `if` interno à prop
  ficava preso em "true" e o spinner nunca sumia. O `if` inline do chamador é
  re-avaliado ao vivo (mesmo padrão do `if` que esconde/mostra a grid).
  `note` sobrescreve o spano padrão quando fornecido (prop ausente → vazio).
-->
<component>
  <!-- `note` é a única prop, e é opcional: sem ela vale o texto padrão. O
    `default=""` reproduz exatamente o comportamento antigo (prop ausente
    resolvia para string vazia) — só que agora declarado. -->
  <props>
    <prop name="note" default="" />
  </props>
  <resources>
    <style>
    .loading_row  {
      spacing: 9;
      align-y: center;
      padding: 8;
    }

    .loading_spin {
      size: 16;
      color: var(--spin);
    }

    .loading_note {
      size: 13;
      color: var(--muted);
    }
    </style>
  </resources>

  <row class="loading_row">
    <text class="loading_spin">⟳</text>
    <text class="loading_note" if="{note}" not_equals="">
      {note}
    </text>
    <text class="loading_note" if="{note}" equals="">
      Carregando dados…
    </text>
  </row>
</component>
