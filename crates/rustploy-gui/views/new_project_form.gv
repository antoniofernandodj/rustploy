<!-- Janela "Novo projeto": motor Glacier próprio, aberto por open_window a partir
  do app principal (handlers/projects.luau → open_new_project_window), que semeia
  a conexão (api_url/api_token) via open_window({ data = ... }). Ao concluir,
  o script (scripts/new_project_window.luau) emite broadcast("project_created")
  e chama close_window(). Linka o tema + o app.gss para herdar a mesma aparência
  (cada janela é um motor isolado; o stylesheet não vem "de graça"). Borderless
  (a janela é aberta com decorations=false, como a principal): o titlebar abaixo
  é custom, e suas ações window:* são tratadas no runtime (app/mod.rs). -->
<screen title="Novo projeto — Rustploy" size="460 340">
  <resources>
    <link rel="theme"       href="crates/rustploy-gui/views/styles/theme.json" />
    <link rel="stylesheet"  href="crates/rustploy-gui/views/styles/app.gss" />

    <style>
      /* Titlebar custom (mesma linguagem visual do app.gv) */
      .titlebar       { width: fill; height: 32; background: var(--surface); align-y: center; }
      .titlebar_drag  { width: fill; height: fill; align-y: center; padding: 0 0 0 16; spacing: 9; }
      .titlebar_dot   { size: 10; color: var(--blue); }
      .titlebar_title { size: 12; bold: true; color: var(--muted); }
      .win_btn        { width: 48; padding: 5 0; color: var(--border); text-align: center; }
      .win_close      { width: 48; padding: 5 0; color: var(--danger); text-align: center; }

      /* sem `background: var(--bg)`: é a cor do tema, já pintada na janela
         inteira — repeti-la era uma camada redobrada em cada pixel (ver
         PRIMITIVAS.md, "O que custa num quadro"). */
      .np_screen  { width: fill; height: fill; }
      .np_wrap    { width: fill; height: fill; padding: 24; spacing: 18; }
      .np_head    { width: fill; spacing: 5; }
      .np_title   { size: 20; bold: true; color: var(--text); }
      .np_group   { width: fill; spacing: 6; }
      .np_label   { size: 11; bold: true; color: var(--muted); }
      .np_input   { width: fill; }
      .np_actions { width: fill; spacing: 10; align-y: center; }
      .np_spacer  { width: fill; }
    </style>

    <script src="scripts/new_project_window.luau"></script>
  </resources>

  <column class="np_screen">

    <!-- Titlebar custom (janela borderless). window:drag/minimize/close tratados
      no runtime contra o id desta janela; sem maximize (é um diálogo fixo). -->
    <row class="titlebar">
      <row class="titlebar_drag" on_press="window:drag">
        <text class="titlebar_dot">●</text>
        <text class="titlebar_title">Novo projeto — Rustploy</text>
      </row>
      <button class="win_btn"   on_click="window:minimize" text="—" />
      <button class="win_close" on_click="window:close"    text="✕" />
    </row>

    <column class="np_wrap">

      <column class="np_head">
        <text class="np_title">Novo projeto</text>
        <text class="muted">Cadastre um projeto no cluster conectado.</text>
      </column>

      <!-- Validação declarada no <form> (glacier-ui 0.102+): as regras moram no
        campo (`rules=`), o motor valida ao enviar e roteia `on_submit` (tudo
        certo) ou `on_validation_error` (algo falhou). O `<button type="submit">`
        dispara sem `on_click`; o `.np_input:invalid` (app.gss) acende sozinho. -->
      <form
        name="np_form"
        on_submit="submit_project"
        on_validation_error="np_apontar"
        width="fill"
        spacing="14"
      >

        <column class="np_group">
          <text class="np_label">NOME</text>
          <input
            class="np_input"
            form_control="np_name"
            rules="required"
            msg="informe um nome"
            placeholder="Nome do projeto"
          />
          <text class="err" if="{erro_np_name}" not_empty>{erro_np_name}</text>
        </column>

        <column class="np_group">
          <text class="np_label">DESCRIÇÃO (OPCIONAL)</text>
          <input
            class="np_input"
            form_control="np_desc"
            placeholder="Descrição"
          />
        </column>

        <!-- Erros de rede/RPC (não de campo) e o status "criando…" — spinner
          enquanto o RPC está no ar ({np_busy}). -->
        <text if="{np_err}" not_equals="" class="err">{np_err}</text>
        <row class="busy_row" if="{np_msg}" not_equals="">
          <spinner class="busy_spin" if="{np_busy}" />
          <text class="muted">{np_msg}</text>
        </row>

        <row class="np_actions">
          <column class="np_spacer" />
          <button class="btn_ghost" on_click="cancel" text="Cancelar" />
          <button type="submit" class="btn_primary" text="Criar projeto" />
        </row>

      </form>

    </column>

  </column>
</screen>
